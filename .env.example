# HTTP
PORT=3000

# PostgreSQL (docker-compose)
DATABASE_URL=postgres://tfa:tfa@localhost:5432/tfa

# RabbitMQ (docker-compose); очередь consumer'а синхронизации юзеров
RMQ_URL=amqp://tfa:tfa@localhost:5672
RMQ_USERS_QUEUE=tfa-users-sync

# --- Секреты: обязательны, дефолтов нет ---
# HMAC-SHA256 для хэшей кодов, минимум 32 символа
CODES_HMAC_SECRET=
# Ключи AES-256-GCM для TOTP-секретов: JSON {"<версия>":"<64 hex>"}.
# Ротация: добавить новую версию, переключить TOTP_ENC_KEY_VERSION —
# старые версии остаются для расшифровки.
TOTP_ENC_KEYS=
TOTP_ENC_KEY_VERSION=

# --- Коды и лимиты (дефолты в скобках) ---
# CODE_LENGTH=6
# CODE_TTL_SECONDS=300           # TTL кода = TTL операции
# CODE_RETRY_SECONDS=120         # окно до переотправки, < CODE_TTL_SECONDS
# CODE_ATTEMPTS_LIMIT=3          # попыток ввода на тип
# CODE_RESENDS_LIMIT=3           # переотправок на тип
# OPERATIONS_DAILY_LIMIT=10      # операций в сутки на «актор × метод»
# UNAUTHED_IP_HOURLY_LIMIT=20    # unauthed-операций в час на client IP
# RETENTION_DAYS=30              # хранение завершённых/истёкших операций

# Интроспекция гейтвея для updateListMethods (без него автосинк недоступен)
# GATEWAY_GRAPHQL_URL=http://localhost:4000/graphql

# Событие отправки кода в events-сервис
# SEND_EVENT_NAME=TFA_OTP
# SEND_PROVIDER_MAP={"email":"smtp","sms":"sms"}
